# MiraForge 后端环境变量（复制为 .env 后修改）
# 前端绝不直连 ComfyUI：只有后端读这些值。

# ComfyUI 地址（本机 ComfyUI 未带 --listen，只能走 127.0.0.1）
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=2.0

# 数据库（相对路径以项目根目录 D:\AI\MiraForge 为基准）
DATABASE_URL=sqlite:///./data/app.db

# 存储目录
STORAGE_DIR=./storage

# 任务
MAX_GENERATION_COUNT=8
# 图生图一次最多几张参考图（工作流的 LoadImage 槽位要够）
MAX_REFERENCE_IMAGES=2
WORKER_CONCURRENCY=1

# 服务
# 0.0.0.0 = 允许局域网 / 手机访问；只想本机用就写 127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
# 用局域网 IP 打开前端时不用改这里：后端另用 allow_origin_regex 放行私有网段
APP_VERSION=0.1.0
DEBUG=false

# 启动时自动执行 alembic upgrade head
AUTO_MIGRATE=true
