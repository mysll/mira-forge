# MiraForge 后端环境变量（复制为 .env 后修改）
# 前端绝不直连 ComfyUI：只有后端读这些值。

# ComfyUI 地址（本机 ComfyUI 未带 --listen，只能走 127.0.0.1）
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=2.0

# 数据库（相对路径以项目根目录 D:\AI\MiraForge 为基准）
DATABASE_URL=sqlite:///./data/app.db

# 存储目录
STORAGE_DIR=./storage

# 任务
MAX_GENERATION_COUNT=8
WORKER_CONCURRENCY=1

# 服务
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:3000
APP_VERSION=0.1.0
DEBUG=false

# 启动时自动执行 alembic upgrade head
AUTO_MIGRATE=true
